show_startup_tips false
theme "nightfox"
default_layout "default"
default_shell "zsh"
scrollback_editor "nvim"
pane_frames true
mouse_mode true
osc8_hyperlinks true

ui {
  pane_frames {
    rounded_corners true
  }
}

keybinds {
  normal clear-defaults=true {
    bind "Ctrl space" { SwitchToMode "Locked"; }
    bind "Ctrl b" { SwitchToMode "Locked"; }
  }

  locked clear-defaults=true {
    bind "Ctrl space" { SwitchToMode "Normal"; }
    bind "Ctrl b" { SwitchToMode "Normal"; }
    bind "Esc" { SwitchToMode "Normal"; }
    bind "p" { SwitchToMode "Pane"; }
    bind "t" { SwitchToMode "Tab"; }
    bind "s" { SwitchToMode "Scroll"; }
    bind "q" { Quit; }
    // 入れ子セッションとの行き来。入れ子 (guest) の中で "]" を押すと親 (host) に戻り、
    // 親で "[" を押すとフォーカス中のペインの入れ子に入る。
    bind "]" { SwitchToMode "Normal"; FocusHostSession; }
    bind "[" { SwitchToMode "Normal"; FocusGuestSession; }
  }
}
