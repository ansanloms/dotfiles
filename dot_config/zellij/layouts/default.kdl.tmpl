{{- /*
  ペインのコマンドは OS で分岐する。Windows には zsh / bash を配らないため pwsh で起動する。
  nvim の listen 先は Linux / macOS が unix socket (/tmp/nvim-<セッション名>.sock)、
  Windows が named pipe (\\.\pipe\nvim-<セッション名>)。
  nvim 側の導出は dot_config/nvim/lua/zellij/init.lua の nvim_socket_path() と揃える。
*/ -}}
layout {
  default_tab_template {
    pane size=1 borderless=true {
      plugin location="zellij:compact-bar"
    }

    children
  }

  new_tab_template {
    pane size=1 borderless=true {
      plugin location="zellij:compact-bar"
    }

    pane {
      name "Terminal"
{{- if eq .chezmoi.os "windows" }}
      command "pwsh"
      args "-NoLogo"
{{- else }}
      command "zsh"
      args "-li"
{{- end }}
    }
  }

  tab {
    pane split_direction="vertical" {
      pane size="30%" {
        name "AI Agent"
{{- if eq .chezmoi.os "windows" }}
        command "pwsh"
        args "-NoLogo" "-NoProfile" "-Command" "if ($Env:ZELLIJ_AI_AGENT) { Invoke-Expression $Env:ZELLIJ_AI_AGENT } else { claude agents --cwd $PWD.Path }"
{{- else }}
        command "bash"
        args "-c" "if [ -n \"$ZELLIJ_AI_AGENT\" ]; then exec $ZELLIJ_AI_AGENT; else exec claude agents --cwd \"$PWD\"; fi"
{{- end }}
      }

      pane {
        pane {
          name "Neovim"
          focus true
{{- if eq .chezmoi.os "windows" }}
          command "pwsh"
          args "-NoLogo" "-NoProfile" "-Command" "nvim --listen \\\\.\\pipe\\nvim-$Env:ZELLIJ_SESSION_NAME"
{{- else }}
          command "bash"
          args "-c" "nvim --listen /tmp/nvim-${ZELLIJ_SESSION_NAME}.sock"
{{- end }}
        }

        pane size="25%" {
          name "Terminal"
{{- if eq .chezmoi.os "windows" }}
          command "pwsh"
          args "-NoLogo"
{{- else }}
          command "zsh"
          args "-li"
{{- end }}
        }
      }
    }
  }
}
