# chezmoi の source はリポジトリ直下。`.` 始まりのエントリは chezmoi が既定で無視する。
# このファイルは 2 用途。
# (1) リポジトリ管理ファイル・生成物の除外 (次のブロック。移行が進んで不要になった行は削除する)。
# (2) OS 別の配布制御 (`.chezmoi.os` 分岐のブロック。削除対象ではない)。
README.md
CLAUDE.md
config.yaml
deno.json
deno.lock
scripts
# apm の project scope 時代の残骸 (既存 clone に残る)。消した後はこの 3 行も消してよい。
apm.yml
apm.lock.yaml
apm_modules
AppData
Documents
result
coverage

# nvim が target 側に書く・ローカル専用のファイル。chezmoi add / apply の対象から外す。
.config/nvim/lazy-lock.json
.config/nvim/lua/temp.lua
.config/nvim/lua/work.lua

# git: config.os の include 元 (OS 別の断片) と、ローカル専用・秘匿ファイル。chezmoi add / apply の対象から外す。
.config/git/config.linux
.config/git/config.windows
.config/git/credentials
.config/git/config.personal
.config/git/config.work
# config.os は linux と windows だけ (dot-mori 時代の targets を維持)。
{{ if eq .chezmoi.os "darwin" }}
.config/git/config.os
{{ end }}

# bash 設定は linux のみ (dot-mori 時代の targets を維持)。
{{ if ne .chezmoi.os "linux" }}
.bashrc
.bash_profile
.inputrc
{{ end }}
# zsh 系・bash_aliases は darwin と linux のみ。
{{ if and (ne .chezmoi.os "linux") (ne .chezmoi.os "darwin") }}
.bash_aliases
.zshenv
.zshrc
.zprofile
.config/zsh
.config/sheldon
{{ end }}
