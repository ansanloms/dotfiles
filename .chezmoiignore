# chezmoi の source はリポジトリ直下。`.` 始まりのエントリは chezmoi が既定で無視する。
# このファイルは 2 用途。
# (1) リポジトリ管理ファイル・生成物の除外 (次のブロック)。
# (2) OS 別の配布制御 (`.chezmoi.os` 分岐のブロック。削除対象ではない)。
README.md
CLAUDE.md
docs
result

# nvim が target 側に書く・ローカル専用のファイル。chezmoi add / apply の対象から外す。
.config/nvim/lazy-lock.json
.config/nvim/lua/temp.lua
.config/nvim/lua/work.lua

# git: ローカル専用・秘匿ファイル。chezmoi add / apply の対象から外す。
.config/git/credentials
.config/git/config.personal
.config/git/config.work
.config/git/config.personal.*
.config/git/config.work.*

# bash / zsh 系は darwin と linux のみ。
{{ if and (ne .chezmoi.os "linux") (ne .chezmoi.os "darwin") }}
.bashrc
.bash_profile
.inputrc
.bash_aliases
.zshenv
.zshrc
.zprofile
.config/zsh
.config/sheldon
{{ end }}

# Windows 専用の配布物。Windows 以外では配らない。
{{ if ne .chezmoi.os "windows" }}
AppData
Documents
.wslconfig
# フォント登録スクリプト。
register-fonts.ps1
{{ end }}

# alacritty / ghostty の本体 (alacritty.toml / config.ghostty) は全 OS で .config 配下に配る。
# Windows の alacritty は %APPDATA% しか見ないため AppData 側の include stub を読み、.config 側は Windows では使われない。
# include 元の OS 別断片は target に置かない。
.config/alacritty/linux.toml
.config/alacritty/windows.toml
.config/ghostty/windows.ghostty

# nix は linux のみ。
{{ if ne .chezmoi.os "linux" }}
.config/nix
{{ end }}
