{
  "$schema": "https://raw.githubusercontent.com/denoland/deno/refs/heads/main/cli/schemas/config-file.v1.json",
  "workspace": [
    "./scripts/clip-image",
    "./scripts/git-worktree",
    "./scripts/md2html",
    "./scripts/notify"
  ],
  "exclude": [
    ".claude/worktrees/"
  ],
  "fmt": {
    "proseWrap": "preserve",
    "exclude": [
      "AppData/Local/Packages/Microsoft.WindowsTerminal_8wekyb3d8bbwe/LocalState/settings.json",
      "AppData/Roaming/CorvusSKK/config.xml",
      "apm.lock.yaml",
      "apm.yml",
      ".claude/skills/"
    ]
  },
  "lint": {
    "rules": {
      "tags": [
        "recommended"
      ]
    },
    "plugins": [
      "jsr:@aireone/deno-lint-curly"
    ]
  },
  "imports": {
    "dot-mori/": "https://cdn.jsdelivr.net/gh/ansanloms/dot-mori@0.2.0/",
    "@std/assert": "jsr:@std/assert@1.0.19",
    "@std/cli": "jsr:@std/cli@1.0.32",
    "@std/path": "jsr:@std/path@1.1.6"
  },
  "tasks": {
    "dot-mori": {
      "description": "Manage and install dotfiles.",
      "command": "deno run --allow-env=NODE_*,HOME,USERPROFILE --allow-read --allow-write dot-mori/cli.ts"
    },
    "lint": "deno lint && deno fmt --check",
    "fix": "deno lint --fix && deno fmt",
    "check": "deno check ./scripts/**/*.ts .config/nix/**/*.ts",
    "test": "deno test --allow-read --allow-write --allow-net --allow-env=VSCODE_TEXTMATE_DEBUG scripts/",
    "coverage": "deno test --allow-read --allow-write --allow-net --allow-env=VSCODE_TEXTMATE_DEBUG --coverage=coverage scripts/ && deno coverage coverage",
    "build": "deno run --allow-read=scripts --allow-write=.local/bin --allow-run=deno --allow-env=LD_LIBRARY_PATH scripts/build.ts",
    "install": "deno task dot-mori --config ./config.yaml",
    "uninstall": "deno task dot-mori --config ./config.yaml --clean",
    "switch": {
      "description": "Apply package changes to the profile (packages.nix / *.nix / flake.lock).",
      "command": "nix profile upgrade --all --impure"
    },
    "upgrade": {
      "description": "Update flake inputs (nixpkgs / llm-agents).",
      "command": "nix flake update --flake path:.config/nix"
    },
    "remove": {
      "description": "Remove flake inputs.",
      "command": "nix profile remove .config/nix"
    },
    "bump": {
      "description": "Bump self-built nix package versions and hashes (apm-cli / playwright-cli / sonarqube-cli / moddable-sdk).",
      "command": "deno task bump:*"
    },
    "bump:apm-cli": "deno run --allow-read=.config/nix --allow-write=.config/nix --allow-run=gh,nix .config/nix/apm-cli/upgrade.ts",
    "bump:playwright-cli": "deno run --allow-read=.config/nix --allow-write=.config/nix --allow-run=npm,nix .config/nix/playwright-cli/upgrade.ts",
    "bump:sonarqube-cli": "deno run --allow-read=.config/nix --allow-write=.config/nix --allow-run=gh,nix .config/nix/sonarqube-cli/upgrade.ts",
    "bump:moddable-sdk": "deno run --allow-read=.config/nix,/nix/store --allow-write=.config/nix --allow-run=git,nix .config/nix/moddable-sdk/upgrade.ts"
  }
}
