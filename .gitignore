**/.env

# dot-mori 時代の旧パス (実行時ファイルの残骸対策)。README の移行手順を終えた後に削除する。
.config/vim/*
!.config/vim/config/
!.config/vim/autoload/
!.config/vim/bitmaps/
!.config/vim/snippets/
!.config/vim/launcher/000-general.yaml
!.config/vim/launcher/001-terminal.yaml
!.config/vim/launcher/002-ai-chat.yaml

# 誤って chezmoi add した実行時ファイルを追跡しないための安全網。
dot_config/vim/backup/
dot_config/vim/undo/
dot_config/vim/view/
dot_config/vim/viminfo
dot_config/vim/temp.vim
dot_config/vim/work.vim
dot_config/vim/syntax/
dot_config/vim/pack/
dot_config/vim/plugin/
dot_config/vim/logs/

.config/git/credentials
.config/git/config.os
.config/git/config.work
.config/git/config.personal

# dot-mori 時代の旧パス。README の chezmoi 移行手順を終えた後に削除する。
.config/nvim/lazy-lock.json
.config/nvim/lua/temp.lua

dot_config/nvim/lua/temp.lua
dot_config/nvim/lazy-lock.json

.config/alacritty/os.toml

# apm の project scope 時代の残骸 (既存 clone に残る skill 実体と apm_modules)。消した後はこの行も消してよい。
apm_modules/
.claude/skills/*

# nix build の成果物（store パスへの symlink）
result

# .local/bin/ 配下は scripts/ から deno bundle で生成する（deno task build）。
# ディレクトリ自体は .gitkeep で残し、生成物はコミットしない。
/.local/bin/*
!/.local/bin/.gitkeep

# deno task coverage の出力
/coverage/
