if [ -f "$HOME/.bash_aliases" ]; then
  source "$HOME/.bash_aliases"
fi

if [ -f "$HOME/.config/zsh/prompt.zsh" ]; then
  source "$HOME/.config/zsh/prompt.zsh"
fi

if type sheldon > /dev/null 2>&1; then
  eval "$(sheldon source)"
fi

# WSL では Windows 側の ssh-agent.exe を使う。wsl2-ssh-agent は既に daemon が居れば再利用し、
# 居なければ自身を daemon 化して SSH_AUTH_SOCK の export 文を出力する。
# @see https://github.com/mame/wsl2-ssh-agent
if is-wsl && type wsl2-ssh-agent > /dev/null 2>&1; then
  eval "$(wsl2-ssh-agent)"
fi

# git wt ls で worktree 選択して cd
git() {
  if [[ "$1" == "wt" && "$2" == "ls" ]]; then
    local dir
    dir=$(command git worktree-select)
    [[ -n "$dir" ]] && cd "$dir"
  else
    command git "$@"
  fi
}


# aws login は fzf で profile を選んで実行する (--profile 指定時と help は素通し)
aws() {
  if [[ "$1" == "login" && "$2" != "help" ]]; then
    local arg
    for arg in "$@"; do
      if [[ "$arg" == "--profile" || "$arg" == --profile=* ]]; then
        command aws "$@"
        return
      fi
    done
    shift
    command aws-login-select "$@"
  else
    command aws "$@"
  fi
}

